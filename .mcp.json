{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {}
    },
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "gmail": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@gongrzhe/server-gmail-autoauth-mcp"
      ],
      "env": {}
    },
    "twitter-x": {
      "command": "npx",
      "args": [
        "-y",
        "@mbelinky/x-mcp-server"
      ],
      "env": {
        "AUTH_TYPE": "oauth2",
        "OAUTH2_CLIENT_ID": "${X_CLIENT_ID}",
        "OAUTH2_CLIENT_SECRET": "${X_CLIENT_SECRET}",
        "OAUTH2_ACCESS_TOKEN": "${X_ACCESS_TOKEN}",
        "OAUTH2_REFRESH_TOKEN": "${X_REFRESH_TOKEN}"
      }
    },
    "odoo": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-odoo"
      ],
      "env": {
        "ODOO_URL": "${ODOO_URL}",
        "ODOO_API_KEY": "${ODOO_API_KEY}",
        "ODOO_USER": "${ODOO_USER}",
        "ODOO_DB": "${ODOO_DB}",
        "ODOO_YOLO": "${ODOO_YOLO}"
      }
    },
    "xero": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@xeroapi/xero-mcp-server@latest"
      ],
      "env": {
        "XERO_CLIENT_ID": "'${XERO_CLIENT_ID}'",
        "XERO_CLIENT_SECRET": "'${XERO_CLIENT_SECRET}'"
      }
    }
  }
}