# AI Employee Configuration Template
# Copy this file to .env and fill in your values

# Agent Configuration
AGENT_NAME=cloud-agent
# Options: cloud-agent, local-agent

# Vault Configuration
VAULT_PATH=../AI_Employee_Vault
# Path to the vault directory relative to app/ directory (or use absolute path)

# Git Sync Configuration
GIT_SYNC_ENABLED=true
# Enable/disable automatic Git synchronization (true/false)

# Claim Protocol Configuration
CLAIM_TIMEOUT_MINUTES=30
# Time in minutes before a claimed task is considered stalled

# Watchdog Configuration
WATCHDOG_ENABLED=true
# Enable/disable task watchdog monitoring (true/false)

WATCHDOG_INTERVAL_SECONDS=300
# Interval in seconds between watchdog checks (default: 300 = 5 minutes)

# Dashboard Configuration
DASHBOARD_MERGE_INTERVAL_SECONDS=300
# Interval in seconds for local agent to merge updates into Dashboard.md (default: 300 = 5 minutes)

# Logging Configuration
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

LOG_DIR=logs
# Directory for application logs


# Odoo Configuration
ODOO_URL=http://localhost:8069
# URL of your Odoo instance (local: http://localhost:8069, cloud: https://your-domain.odoo.com)

ODOO_DB=my_business
# Odoo database name (created during Odoo setup)

ODOO_USER=admin@example.com
ODOO_API_KEY=your_api_key_here
# API key from Odoo (Settings > Users > API Keys)
# Alternative: Use ODOO_PASSWORD instead

# ODOO_PASSWORD=your_password
# (Optional) Username/password authentication instead of Username/API key

ODOO_YOLO=read
# YOLO mode for testing: 'read' (read-only), 'true' (full access), or remove for production
# WARNING: Remove this in production after installing the MCP module in Odoo
