# AI Employee Configuration Template
# Copy this file to .env and fill in your values

# Agent Configuration
AGENT_NAME=cloud-agent
# Options: cloud-agent, local-agent

# Vault Configuration
VAULT_PATH=../AI_Employee_Vault
# Path to the vault directory relative to app/ directory (or use absolute path)

# Git Sync Configuration
GIT_SYNC_ENABLED=true
# Enable/disable automatic Git synchronization (true/false)

# Claim Protocol Configuration
CLAIM_TIMEOUT_MINUTES=30
# Time in minutes before a claimed task is considered stalled

# Watchdog Configuration
WATCHDOG_ENABLED=true
# Enable/disable task watchdog monitoring (true/false)

WATCHDOG_INTERVAL_SECONDS=300
# Interval in seconds between watchdog checks (default: 300 = 5 minutes)

# Dashboard Configuration
DASHBOARD_MERGE_INTERVAL_SECONDS=300
# Interval in seconds for local agent to merge updates into Dashboard.md (default: 300 = 5 minutes)

# Logging Configuration
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

LOG_DIR=logs
# Directory for application logs
