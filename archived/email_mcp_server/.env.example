# Email MCP Server Test Configuration
# Copy this file to .env and fill in your actual credentials

# Enable integration tests (set to "true" to run integration tests)
ENABLE_INTEGRATION_TESTS=false

# Email account for testing
TEST_EMAIL_ADDRESS=your-test-email@gmail.com
TEST_EMAIL_PASSWORD=your-app-password
# Or use app password for Gmail (recommended)
TEST_EMAIL_APP_PASSWORD=your-app-password

# SMTP server settings
TEST_SMTP_SERVER=smtp.gmail.com
TEST_SMTP_PORT=587

# IMAP server settings
TEST_IMAP_SERVER=imap.gmail.com
TEST_IMAP_PORT=993

# Recipient for test emails (can be the same as TEST_EMAIL_ADDRESS)
TEST_RECIPIENT=test@example.com

# JWT secret for authentication (change this in production!)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth settings (fill in if using OAuth)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8080/callback

OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:8080/callback

YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=http://localhost:8080/callback
